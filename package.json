{
  "name": "@explita/tunnel-server-plugin",
  "version": "0.1.0",
  "description": "Explita Tunnel all-in-one database, auth, and metrics telemetry plugin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tunnel-plugin": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "db:gen": "npx prisma generate",
    "db:push": "pnpm db:gen && npx prisma db push",
    "build": "pnpm clean && pnpm db:gen && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@explita/cache": "^0.2.0",
    "@explita/env-loader": "^0.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "nodemailer": "^6.10.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@explita/infra-protocol": "^0.1.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^6.4.17",
    "fastify": "^5",
    "rimraf": "^6.1.3",
    "typescript": "^7"
  },
  "peerDependencies": {
    "@explita/infra-protocol": "^0.1.0",
    "fastify": "^5"
  },
  "files": [
    "dist",
    "bin",
    "prisma",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
